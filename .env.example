# Copie para .env e preencha. Variáveis EXPO_PUBLIC_ vão dentro do app: só valores públicos aqui.

# Endereço da API (repo focaai-api). No emulador Android, localhost do computador é 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Client IDs OAuth do Google Cloud (os mesmos de GOOGLE_CLIENT_IDS na API).
# Web: usado no app web e, no Android, para pedir o ID token que a API confere.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS: também vira o URL scheme que traz o login de volta ao app (app.config.ts).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Só com a API local (./mvnw spring-boot:test-run no focaai-api): mostra "Entrar como aluno de teste"
# na tela de entrada, para usar o app antes de configurar o Google. Não existe em builds de produção.
EXPO_PUBLIC_DEV_LOGIN=
